<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_dark"
    android:padding="20dp">
    <LinearLayout
        android:id="@+id/linear110"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/imageview47"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_nav_explore"
            android:scaleType="center"
            android:focusable="false"
            android:contentDescription="Negara" />
        <TextView
            android:id="@+id/textview81"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="10dp"
            android:text="Pilih Negara Asal (Custom List)"
            android:textSize="16sp"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:focusable="false" />
        <ImageView
            android:id="@+id/btn_close_country_dialog"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_close"
            android:scaleType="center"
            android:focusable="false"
            android:contentDescription="Tutup" />
    </LinearLayout>
    <TextView
        android:id="@+id/textview82"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Pilih negara asal produksi film untuk memfilter katalog secara akurat."
        android:textSize="12sp"
        android:textColor="#FF94A3B8"
        android:focusable="false" />
    <LinearLayout
        android:id="@+id/linear111"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginTop="14dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:background="@drawable/bg_search_input">
        <ImageView
            android:id="@+id/imageview48"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_search"
            android:scaleType="center"
            android:focusable="false"
            android:contentDescription="Cari" />
        <EditText
            android:id="@+id/edt_search_dialog_country"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingLeft="8dp"
            android:textSize="12sp"
            android:textColor="#FFFFFFFF"
            android:singleLine="true"
            android:hint="Cari negara (Indonesia, Korea, dll)..."
            android:textColorHint="#FF64748B"
            android:inputType="text"
            android:background="@null"
            android:focusable="false" />
    </LinearLayout>
    <ScrollView
        android:id="@+id/vscroll6"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_marginTop="12dp"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/layout_dialog_country_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
    <LinearLayout
        android:id="@+id/linear112"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp">
        <Button
            android:id="@+id/btn_dialog_country_all"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginRight="8dp"
            android:background="@drawable/bg_btn_dark"
            android:text="Semua Negara"
            android:textSize="12sp"
            android:textColor="#FFCBD5E1"
            android:textAllCaps="false" />
        <Button
            android:id="@+id/btn_dialog_country_apply"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:background="@drawable/bg_btn_gold"
            android:text="Terapkan Filter"
            android:textSize="12sp"
            android:textColor="#FF0B0E14"
            android:textStyle="bold"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
