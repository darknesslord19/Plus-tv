<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="145dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginRight="12dp">
    <FrameLayout
        android:id="@+id/frame_layout175"
        android:layout_width="145dp"
        android:layout_height="215dp">
        <androidx.cardview.widget.CardView
            android:id="@+id/cardview22"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardBackgroundColor="#FF141923"
            android:elevation="4dp">
            <FrameLayout
                android:id="@+id/frame_layout176"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/img_trending_poster"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Poster Trending" />
                <View
                    android:id="@+id/view177"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/gradient_banner_scrim" />
                <TextView
                    android:id="@+id/txt_trending_quality"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginLeft="8dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="8dp"
                    android:layout_marginBottom="8dp"
                    android:paddingLeft="6dp"
                    android:paddingTop="2dp"
                    android:paddingRight="6dp"
                    android:paddingBottom="2dp"
                    android:background="@drawable/bg_badge_gold"
                    android:text="4K"
                    android:textSize="9sp"
                    android:textColor="#FF0B0E14"
                    android:textStyle="bold" />
                <LinearLayout
                    android:id="@+id/linear178"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginLeft="8dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="8dp"
                    android:layout_marginBottom="8dp"
                    android:paddingLeft="6dp"
                    android:paddingTop="2dp"
                    android:paddingRight="6dp"
                    android:paddingBottom="2dp"
                    android:background="@drawable/bg_badge_dark">
                    <ImageView
                        android:id="@+id/imageview64"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:src="@drawable/ic_star"
                        android:scaleType="fitCenter"
                        android:contentDescription="Rating" />
                    <TextView
                        android:id="@+id/txt_trending_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="3dp"
                        android:text="8.7"
                        android:textSize="10sp"
                        android:textColor="#FFFACC15"
                        android:textStyle="bold" />
                </LinearLayout>
                <TextView
                    android:id="@+id/txt_trending_rank"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginLeft="6dp"
                    android:layout_marginBottom="2dp"
                    android:text="#1"
                    android:textSize="32sp"
                    android:textColor="#FFFACC15"
                    android:textStyle="bold"
                    android:shadowColor="#000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>
    <TextView
        android:id="@+id/txt_trending_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Judul Film"
        android:textSize="13sp"
        android:textColor="#FFFFFFFF"
        android:textStyle="bold"
        android:ellipsize="end"
        android:maxLines="1" />
    <TextView
        android:id="@+id/txt_trending_genre_year"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Aksi • 2024"
        android:textSize="11sp"
        android:textColor="#FF94A3B8"
        android:ellipsize="end"
        android:maxLines="1" />
</LinearLayout>
