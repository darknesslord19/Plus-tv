<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0E14"
    android:fitsSystemWindows="true">
    <LinearLayout
        android:id="@+id/linear87"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:background="#FF0B0E14">
        <FrameLayout
            android:id="@+id/btn_downloads_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_badge_dark">
            <ImageView
                android:id="@+id/imageview38"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_back"
                android:scaleType="center"
                android:contentDescription="Geri" />
        </FrameLayout>
        <TextView
            android:id="@+id/textview72"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="14dp"
            android:text="İndirmelerim"
            android:textSize="17sp"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/btn_clear_all_downloads"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:background="@drawable/bg_badge_dark"
            android:text="Temizle"
            android:textSize="11sp"
            android:textColor="#FF94A3B8" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/linear88"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="12dp"
        android:paddingLeft="12dp"
        android:paddingTop="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="12dp"
        android:background="#FF161B26">
        <ImageView
            android:id="@+id/imageview39"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_download"
            android:scaleType="center"
            android:contentDescription="Bilgi" />
        <TextView
            android:id="@+id/txt_downloads_header_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="Dosyalar İndirilenler klasöründe saklanır"
            android:textSize="11sp"
            android:textColor="#FFCBD5E1" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/layout_empty_downloads"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="32dp"
        android:paddingTop="32dp"
        android:paddingRight="32dp"
        android:paddingBottom="32dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/imageview40"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_folder"
            android:scaleType="center"
            android:contentDescription="Boş" />
        <TextView
            android:id="@+id/textview73"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Henüz indirme yok"
            android:textSize="16sp"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/textview74"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:text="Katalogdan bir video seçip indirebilirsiniz."
            android:textSize="13sp"
            android:textColor="#FF94A3B8" />
        <Button
            android:id="@+id/btn_explore_movies_now"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="20dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:background="@drawable/bg_btn_gold"
            android:text="Kataloğa göz at"
            android:textSize="12sp"
            android:textColor="#FF0B0E14"
            android:textStyle="bold"
            android:textAllCaps="false" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_downloads"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:clipToPadding="false" />
</LinearLayout>
