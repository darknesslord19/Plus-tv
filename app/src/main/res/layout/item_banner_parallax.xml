<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="12dp">
    <androidx.cardview.widget.CardView
        android:id="@+id/card_banner_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="#FF161B26"
        app:cardCornerRadius="14dp"
        app:cardElevation="6dp">
        <FrameLayout
            android:id="@+id/frame_layout139"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/img_banner_backdrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Backdrop Film" />
            <View
                android:id="@+id/view140"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/gradient_banner_scrim" />
            <LinearLayout
                android:id="@+id/linear141"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingBottom="14dp">
                <LinearLayout
                    android:id="@+id/linear142"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">
                    <LinearLayout
                        android:id="@+id/linear143"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginRight="8dp"
                        android:paddingLeft="6dp"
                        android:paddingTop="2dp"
                        android:paddingRight="6dp"
                        android:paddingBottom="2dp"
                        android:background="@drawable/bg_badge_gold">
                        <ImageView
                            android:id="@+id/imageview55"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_star"
                            android:scaleType="fitCenter"
                            android:contentDescription="Rating"
                            android:tint="#000000" />
                        <TextView
                            android:id="@+id/txt_banner_rating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="3dp"
                            android:text="8.9"
                            android:textSize="11sp"
                            android:textColor="#FF0B0E14"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/txt_banner_quality"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="8dp"
                        android:paddingLeft="6dp"
                        android:paddingTop="2dp"
                        android:paddingRight="6dp"
                        android:paddingBottom="2dp"
                        android:background="@drawable/bg_badge_dark"
                        android:text="4K WEB-DL"
                        android:textSize="10sp"
                        android:textColor="#FFF5C518"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/txt_banner_genre"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingLeft="6dp"
                        android:paddingTop="2dp"
                        android:paddingRight="6dp"
                        android:paddingBottom="2dp"
                        android:background="@drawable/bg_badge_dark"
                        android:text="Sci-Fi"
                        android:textSize="10sp"
                        android:textColor="#FF94A3B8" />
                </LinearLayout>
                <TextView
                    android:id="@+id/txt_banner_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Dune: Part Two"
                    android:textSize="18sp"
                    android:textColor="#FFFFFFFF"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />
                <LinearLayout
                    android:id="@+id/linear144"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">
                    <LinearLayout
                        android:id="@+id/btn_banner_play"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:background="@drawable/bg_btn_gold">
                        <ImageView
                            android:id="@+id/imageview56"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_play"
                            android:scaleType="fitCenter"
                            android:contentDescription="Play"
                            android:tint="#000000" />
                        <TextView
                            android:id="@+id/textview108"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="6dp"
                            android:text="Lihat Film"
                            android:textSize="11sp"
                            android:textColor="#FF000000"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/txt_banner_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:text="2j 46m - 2024"
                        android:textSize="12sp"
                        android:textColor="#FF94A3B8" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
