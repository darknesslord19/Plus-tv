<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#161B26"
    android:orientation="vertical"
    android:padding="20dp">
    <LinearLayout
        android:id="@+id/linear129"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/imageview52"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_download"
            android:scaleType="center"
            android:contentDescription="İndir" />
        <TextView
            android:id="@+id/textview100"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="10dp"
            android:text="İndirme seçenekleri"
            android:textSize="17sp"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold" />
        <ImageView
            android:id="@+id/btn_dialog_close"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:paddingLeft="4dp"
            android:paddingTop="4dp"
            android:paddingRight="4dp"
            android:paddingBottom="4dp"
            android:src="@drawable/ic_close"
            android:scaleType="center"
            android:contentDescription="Kapat" />
    </LinearLayout>
    <TextView
        android:id="@+id/txt_dialog_movie_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:text="Film adı"
        android:textSize="13sp"
        android:textColor="#FFF5C518" />
    <LinearLayout
        android:id="@+id/opt_quality_1080p"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp"
        android:paddingLeft="14dp"
        android:paddingTop="14dp"
        android:paddingRight="14dp"
        android:paddingBottom="14dp"
        android:background="@drawable/bg_quality_card">
        <RadioButton
            android:id="@+id/radio_1080p"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:clickable="false"
            android:checked="true"
            android:buttonTint="#F5C518" />
        <LinearLayout
            android:id="@+id/linear130"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginLeft="10dp">
            <TextView
                android:id="@+id/textview101"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1080p seçeneği"
                android:textSize="14sp"
                android:textColor="#FFFFFFFF"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/textview102"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Listedeki bağlantı kullanılır"
                android:textSize="11sp"
                android:textColor="#FF94A3B8" />
        </LinearLayout>
        <TextView
            android:id="@+id/txt_size_1080p"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2.4 GB"
            android:textSize="13sp"
            android:textColor="#FFF5C518"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/opt_quality_720p"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp"
        android:paddingLeft="14dp"
        android:paddingTop="14dp"
        android:paddingRight="14dp"
        android:paddingBottom="14dp"
        android:background="@drawable/bg_quality_card">
        <RadioButton
            android:id="@+id/radio_720p"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:clickable="false"
            android:buttonTint="#F5C518" />
        <LinearLayout
            android:id="@+id/linear131"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginLeft="10dp">
            <TextView
                android:id="@+id/textview103"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="720p seçeneği"
                android:textSize="14sp"
                android:textColor="#FFFFFFFF"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/textview104"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Listedeki bağlantı kullanılır"
                android:textSize="11sp"
                android:textColor="#FF94A3B8" />
        </LinearLayout>
        <TextView
            android:id="@+id/txt_size_720p"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.1 GB"
            android:textSize="13sp"
            android:textColor="#FFF5C518"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/opt_quality_480p"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp"
        android:paddingLeft="14dp"
        android:paddingTop="14dp"
        android:paddingRight="14dp"
        android:paddingBottom="14dp"
        android:background="@drawable/bg_quality_card">
        <RadioButton
            android:id="@+id/radio_480p"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:clickable="false"
            android:buttonTint="#F5C518" />
        <LinearLayout
            android:id="@+id/linear132"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginLeft="10dp">
            <TextView
                android:id="@+id/textview105"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="480p seçeneği"
                android:textSize="14sp"
                android:textColor="#FFFFFFFF"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/textview106"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Listedeki bağlantı kullanılır"
                android:textSize="11sp"
                android:textColor="#FF94A3B8" />
        </LinearLayout>
        <TextView
            android:id="@+id/txt_size_480p"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="520 MB"
            android:textSize="13sp"
            android:textColor="#FFF5C518"
            android:textStyle="bold" />
    </LinearLayout>
    <Button
        android:id="@+id/btn_confirm_download"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_btn_green"
        android:text="Şimdi indir"
        android:textSize="14sp"
        android:textColor="#FFFFFFFF"
        android:textStyle="bold"
        android:textAllCaps="false" />
</LinearLayout>
