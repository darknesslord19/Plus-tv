<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="10dp">
    <androidx.cardview.widget.CardView
        android:id="@+id/cardview17"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FF161B26"
        app:cardCornerRadius="10dp"
        app:cardElevation="3dp">
        <LinearLayout
            android:id="@+id/linear152"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="10dp"
            android:paddingTop="10dp"
            android:paddingRight="10dp"
            android:paddingBottom="10dp">
            <androidx.cardview.widget.CardView
                android:id="@+id/cardview18"
                android:layout_width="55dp"
                android:layout_height="75dp"
                app:cardBackgroundColor="#FF0B0E14"
                app:cardCornerRadius="6dp">
                <ImageView
                    android:id="@+id/img_download_poster"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Poster" />
            </androidx.cardview.widget.CardView>
            <LinearLayout
                android:id="@+id/linear153"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="8dp">
                <TextView
                    android:id="@+id/txt_download_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Film adı"
                    android:textSize="14sp"
                    android:textColor="#FFFFFFFF"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />
                <LinearLayout
                    android:id="@+id/linear154"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginTop="3dp">
                    <TextView
                        android:id="@+id/txt_download_quality"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingLeft="5dp"
                        android:paddingTop="1dp"
                        android:paddingRight="5dp"
                        android:paddingBottom="1dp"
                        android:background="@drawable/bg_badge_gold"
                        android:text="1080p Full HD"
                        android:textSize="9sp"
                        android:textColor="#FF0B0E14"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/txt_download_filename"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:text="video.mp4"
                        android:textSize="10sp"
                        android:textColor="#FF94A3B8"
                        android:maxLines="1"
                        android:ellipsize="middle" />
                </LinearLayout>
                <ProgressBar
                    android:id="@+id/prog_download_status"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progress="45"
                    style="?android:progressBarStyleHorizontal"
                    android:progressTint="#F5C518"
                    android:progressBackgroundTint="#2A3245" />
                <LinearLayout
                    android:id="@+id/linear155"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">
                    <TextView
                        android:id="@+id/txt_download_status_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="İndiriliyor (%45)"
                        android:textSize="11sp"
                        android:textColor="#FFF5C518" />
                    <TextView
                        android:id="@+id/txt_download_bytes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="450 MB / 1.1 GB"
                        android:textSize="11sp"
                        android:textColor="#FF94A3B8" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/linear156"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">
                <FrameLayout
                    android:id="@+id/btn_download_action"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_badge_dark">
                    <ImageView
                        android:id="@+id/img_download_action_icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_close"
                        android:scaleType="center"
                        android:contentDescription="Sil veya aç" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
